{
  "expo": {
    "name": "Workpunkt",
    "slug": "workpunkt-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "workpunktapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.workpunkt.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "associatedDomains": [
        "applinks:workpunkt.com",
        "applinks:www.workpunkt.com"
      ]
    },
    "android": {
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.workpunkt.app",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "workpunkt.com",
              "pathPrefix": "/auth"
            },
            {
              "scheme": "https",
              "host": "www.workpunkt.com",
              "pathPrefix": "/auth"
            },
            {
              "scheme": "https",
              "host": "workpunkt.com",
              "pathPrefix": "/agent/activate"
            },
            {
              "scheme": "https",
              "host": "www.workpunkt.com",
              "pathPrefix": "/agent/activate"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "f021e257-ee9c-4ca1-bbf2-48d6a389bf48"
      }
    },
    "owner": "avi_srivastava"
  }
}
