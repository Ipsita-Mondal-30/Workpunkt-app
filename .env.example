# Expo public env — copy from WORKPUNKT site values for local dev.
#
# For phones/emulators, prefer your machine LAN IP (not localhost):
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:3000
# The app also rewrites stale LAN hosts to Expo's current Metro IP in __DEV__.
# Android emulator loopback → 10.0.2.2 when hostUri is unavailable.
# After changing this file: npx expo start -c
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_SIGNUP_URL=http://localhost:3001/login
